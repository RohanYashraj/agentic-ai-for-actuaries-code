# Copy this file to .env and paste your key.
# Get a free Google AI Studio key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here

# Optional. Defaults shown; see common/config.py.
# MODEL_PROVIDER=google
# MODEL_ID=gemini-3.8-flash

# Only if you switch MODEL_PROVIDER. Install the matching SDK with
# `uv sync --extra anthropic` or `uv sync --extra openai`.
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
