# Copy this file to .env and fill in your key.
# Get a free Google AI Studio key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here

# Optional overrides (defaults shown):
# MODEL_PROVIDER=google
# MODEL_ID=gemini-3.5-flash-lite

# Only needed if MODEL_PROVIDER is switched (see common/config.py);
# install the matching SDK with `uv sync --extra anthropic` / `--extra openai`.
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# ── Website / server (optional — only for running or deploying web/) ──
# Upstash Redis for durable rate limits and the waitlist; the Vercel
# KV-style names KV_REST_API_URL / KV_REST_API_TOKEN work as aliases.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Rate limits are enforced automatically on Vercel; set ENFORCE=1 to
# exercise them locally. The numeric defaults are shown.
# RATE_LIMIT_ENFORCE=1
# RATE_LIMIT_PER_IP_MIN=4
# RATE_LIMIT_PER_IP_DAY=75
# RATE_LIMIT_GLOBAL_DAY=750

# Optional extra Origin allowlist for the run endpoint (comma-separated).
# ALLOWED_ORIGINS=https://your-site.example

# Where the server copies chapter code from, if not the repo root.
# BOOK_REPO_ROOT=
