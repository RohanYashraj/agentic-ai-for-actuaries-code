{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "python3 ../scripts/build_demos.py --out public/demos",
    "dev": "next dev",
    "dev:all": "concurrently -n web,api -c auto \"npm run dev\" \"../.venv/bin/uvicorn server.main:app --app-dir .. --port 8000 --reload\"",
    "prebuild": "python3 ../scripts/build_demos.py --out public/demos && python3 ../scripts/bundle_backend.py --out _backend",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/codemirror-themes": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^7.0.2"
  }
